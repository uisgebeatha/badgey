<Window x:Class="Badgey.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Badgey"
        Title="Badgey"
        Width="620"
        Height="550"
        MinWidth="540"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F6"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#202124" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Badgey" />
            <TextBlock Margin="0,3,0,0"
                       Foreground="#61656B"
                       Text="Program your 44 × 11 LED name badge" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Text="Slots" />
            <ListBox Grid.Column="1"
                     MinHeight="32"
                     Margin="0,0,12,0"
                     Padding="2"
                     Background="White"
                     BorderBrush="#CED3CF"
                     BorderThickness="1"
                     IsEnabled="{Binding IsSlotSelectionEnabled}"
                     ItemsSource="{Binding Slots}"
                     SelectedItem="{Binding SelectedSlot}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="8" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="1" />
                        <Setter Property="Padding" Value="3,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinWidth="30">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding SlotNumber}" />
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,1,1"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#C7CBC8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPopulated}" Value="True">
                                                <Setter Property="Fill" Value="#39B95A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Column="2"
                    MinHeight="32"
                    Padding="12,4"
                    Click="ClearSlotButton_Click"
                    Content="Clear Slot"
                    IsEnabled="{Binding CanClearSlot}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Text="Content" />
            <ComboBox Grid.Column="1"
                      MinHeight="32"
                      Padding="7,4"
                      DisplayMemberPath="Label"
                      ItemsSource="{Binding ContentTypes}"
                      SelectedItem="{Binding SelectedContent}" />
        </Grid>

        <Grid Grid.Row="3">
            <StackPanel Visibility="{Binding IsTextContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Margin="0,0,0,6"
                           FontWeight="SemiBold"
                           Text="Message" />
                <TextBox MinHeight="36"
                         Padding="9,6"
                         VerticalContentAlignment="Center"
                         FontSize="15"
                         Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsGraphicContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Margin="0,0,0,6"
                           FontWeight="SemiBold"
                           Text="Graphic" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            MinHeight="36"
                            Padding="14,6"
                            Click="LoadImageButton_Click"
                            Content="Load Image"
                            IsEnabled="{Binding CanLoadGraphic}" />
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#61656B"
                               Text="{Binding SelectedFileName}"
                               TextTrimming="CharacterEllipsis" />
                    <CheckBox Grid.Column="2"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              Content="Invert"
                              IsEnabled="{Binding CanInvertGraphic}"
                              IsChecked="{Binding IsGraphicInverted}" />
                </Grid>
            </StackPanel>

            <StackPanel Visibility="{Binding IsAnimationContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Margin="0,0,0,6"
                           FontWeight="SemiBold"
                           Text="Animation" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            MinHeight="36"
                            Padding="14,6"
                            Click="LoadGifButton_Click"
                            Content="Load GIF"
                            IsEnabled="{Binding CanLoadAnimation}" />
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#61656B"
                               Text="{Binding SelectedAnimationFileName}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#61656B"
                               Text="{Binding AnimationFrameCountText}" />
                    <CheckBox Grid.Column="3"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              Content="Invert"
                              IsEnabled="{Binding CanInvertAnimation}"
                              IsChecked="{Binding IsAnimationInverted}" />
                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,16,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="0,0,24,0"
                        Orientation="Horizontal"
                        Visibility="{Binding IsTextOrGraphicContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Text="Mode" />
                <ComboBox Width="150"
                          MinHeight="32"
                          Padding="7,4"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding Modes}"
                          SelectedItem="{Binding SelectedMode}" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Text="Speed" />
            <ComboBox Grid.Column="2"
                      MinHeight="32"
                      Padding="7,4"
                      HorizontalContentAlignment="Center"
                      ItemsSource="{Binding Speeds}"
                      SelectedItem="{Binding Speed}" />

            <Button Grid.Column="4"
                    MinWidth="110"
                    MinHeight="34"
                    Padding="16,6"
                    IsDefault="True"
                    Command="{Binding SendCommand}"
                    Content="Send All" />
        </Grid>

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,7">
                <TextBlock DockPanel.Dock="Left"
                           FontWeight="SemiBold"
                           Text="Preview" />
                <TextBlock HorizontalAlignment="Right"
                           Foreground="#73777D"
                           Text="44 × 11 display preview" />
            </DockPanel>

            <Border Grid.Row="1"
                    MinHeight="118"
                    Padding="10"
                    Background="#E5E8E6"
                    BorderBrush="#CED3CF"
                    BorderThickness="1"
                    CornerRadius="8">
                <local:LedMatrixPreview Bitmap="{Binding PreviewBitmap}"
                                        FrameAnimation="{Binding PreviewAnimation}"
                                        IsScrolling="{Binding IsPreviewScrolling}"
                                        ScrollRepeatGap="{Binding PreviewRepeatGap}"
                                        ScrollRepeatGapIsLit="{Binding PreviewRepeatGapIsLit}"
                                        Speed="{Binding Speed}" />
            </Border>
        </Grid>

        <Grid Grid.Row="6" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Foreground="#50545A"
                           Text="{Binding StatusText}" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="11"
                           Foreground="#73777D"
                           Text="{Binding UploadSummaryText}" />
            </StackPanel>
            <ProgressBar Grid.Column="1"
                         Width="92"
                         Height="4"
                         Margin="12,0,0,0"
                         VerticalAlignment="Center"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</Window>
